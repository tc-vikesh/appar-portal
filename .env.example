# TAP (Transcorp APAAR Portal) - Environment Variables Template
# Copy this file to .env in the project root and fill in the values.

DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=apaar
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

M2P_BASE_URL=https://kycuat.yappay.in
M2P_TENANT=TRANSCORP

TWA_SYNC_URL=https://api.stage.transcorpint.com/user/external/onboard
TWA_AUTH_TOKEN=your-twa-auth-token-here
TWA_ENCRYPTION_KEY=your-twa-encryption-key-here
TWA_WEBHOOK_ALLOWED_IPS=127.0.0.1

ABC_CLIENT_ID=your-abc-client-id-here
ABC_CLIENT_SECRET=your-abc-client-secret-here
ABC_STATUS_UPDATE_WEBHOOK_URL=http://localhost:8001/webhook/abc/application/status/update
ABC_KYC_STATUS_WEBHOOK_URL=http://localhost:8001/webhook/abc/application/kyc-status

# Cashfree Verification & Aadhaar Security Settings
CASHFREE_BASE_URL=https://sandbox.cashfree.com/verification
CASHFREE_CLIENT_ID=your-cashfree-client-id-here
CASHFREE_SECRET_KEY=your-cashfree-secret-key-here
